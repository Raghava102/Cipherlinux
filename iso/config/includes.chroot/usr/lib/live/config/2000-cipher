#!/bin/sh
# Cipher live session: log the live user straight into Cipher.
[ -e /var/lib/live/config/cipher ] && exit 0

user=$(sed -n 's/.*username=\([^ ]*\).*/\1/p' /proc/cmdline)
user=${user:-user}

cat >> /etc/greetd/config.toml <<CONF

[initial_session]
command = "cipher-start"
user = "$user"
CONF

# Point the live user at the installer on first login
home=$(getent passwd "$user" | cut -d: -f6)
if [ -n "$home" ] && [ -f "$home/.config/hypr/hyprland.conf" ]; then
    echo 'exec-once = sleep 4 && notify-send -a Cipher -u critical "Welcome to Cipher (live)" "Press SUPER + SPACE and search Install to put Cipher on this computer."' \
        >> "$home/.config/hypr/hyprland.conf"
fi

mkdir -p /var/lib/live/config
touch /var/lib/live/config/cipher
