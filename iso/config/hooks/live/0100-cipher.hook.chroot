#!/bin/sh
# Install the Cipher desktop into the live image.
set -e
export DEBIAN_FRONTEND=noninteractive

# Build diagnostics: shown as notes on the GitHub Actions run.
diag() { printf '::notice title=%s::%s\n' "$1" "$(printf '%s' "$2" | sed ':a;N;$!ba;s/\n/%0A/g')"; }

apt-get update

# Hyprland + Quickshell from trixie-backports (with their newer dependencies)
apt-get install -y -t trixie-backports \
    hyprland hyprland-guiutils hypridle hyprlock hyprpolkitagent \
    xdg-desktop-portal-hyprland quickshell
apt-get install -y -t trixie-backports hyprpicker || echo "cipher: hyprpicker not available, skipping"
apt-get install -y -t trixie-backports hyprsunset || echo "cipher: hyprsunset not available, skipping"

# The Cipher desktop itself (dropped in by scripts/build-iso.sh)
apt-get install -y /root/cipher-packages/cipher-desktop_*.deb
diag "os-release (before fix)" "$(ls -l /etc/os-release /usr/lib/os-release* 2>&1)
$(dpkg-divert --list '*os-release*' 2>&1)
$(head -n 3 /etc/os-release)"

# Cipher identifies itself everywhere (GNOME About, hostnamectl, neofetch)
if ! grep -q '^ID=cipher' /usr/lib/os-release; then
    echo "cipher: os-release is not Cipher's, restoring it from the package"
    dpkg-divert --package cipher-desktop --add --rename --divert /usr/lib/os-release.debian /usr/lib/os-release || true
    dpkg -i /root/cipher-packages/cipher-desktop_*.deb || true
fi
rm -rf /root/cipher-packages
if [ -L /etc/os-release ] || [ ! -e /etc/os-release ]; then
    ln -sf ../usr/lib/os-release /etc/os-release
else
    cp /usr/lib/os-release /etc/os-release
fi

# Login: GDM (pick Cipher or GNOME); the live ISO auto-logs into Cipher
echo /usr/sbin/gdm3 > /etc/X11/default-display-manager
ln -sf /usr/lib/systemd/system/gdm.service /etc/systemd/system/display-manager.service
systemctl enable cipher-live-autologin.service
# Installed system: every user starts in Cipher the first time (then GDM
# remembers what they pick at the login gear)
systemctl enable cipher-default-session.service

# Cipher is the default session for every new login (GDM remembers each
# user's last choice after that)
if ! grep -q '^DefaultSession=' /etc/gdm3/daemon.conf; then
    sed -i 's/^\[daemon\]/[daemon]\nDefaultSession=cipher.desktop/' /etc/gdm3/daemon.conf
fi

# Cipher Shield: a firewall on by default (allow outgoing, block unsolicited incoming)
if command -v ufw >/dev/null; then
    ufw --force default deny incoming >/dev/null || true
    ufw --force default allow outgoing >/dev/null || true
    sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
    systemctl enable ufw.service || true
fi

# ---- Branding --------------------------------------------------------------
# Login screen: Cipher logo under the user list
if [ -f /etc/gdm3/greeter.dconf-defaults ] && ! grep -q 'cipher' /etc/gdm3/greeter.dconf-defaults; then
    printf "\n[org/gnome/login-screen]\nlogo='/usr/share/cipher/branding/logo-96.png'\n" \
        >> /etc/gdm3/greeter.dconf-defaults
fi

# Text console banner
printf 'Cipher %s \\n \\l\n\n' "$(. /usr/lib/os-release && echo "$VERSION_ID")" > /etc/issue
echo "Cipher" > /etc/issue.net

# Installer: "Install Cipher" with Cipher branding
if [ -d /etc/calamares/branding/debian ]; then
    rm -rf /etc/calamares/branding/cipher
    cp -a /etc/calamares/branding/debian /etc/calamares/branding/cipher
    python3 /usr/share/cipher/branding/calamares-rebrand.py /etc/calamares/branding/cipher
    sed -i 's/^branding:.*/branding: cipher/' /etc/calamares/settings.conf
fi
diag "installer desktop files" "$(grep -l -i -E 'calamares|install-debian' /usr/share/applications/*.desktop 2>&1)"
for f in $(grep -l -i -E 'calamares|install-debian' /usr/share/applications/*.desktop 2>/dev/null); do
    sed -i -E 's/^(Name(\[[^]]*\])?)=.*/\1=Install Cipher/; s/^(GenericName(\[[^]]*\])?)=.*/\1=Install Cipher/; s/^Icon=.*/Icon=cipher-logo/' "$f"
done
systemctl set-default graphical.target

# GNOME Settings > About: Debian builds it with a fixed logo file, so put the
# Cipher wordmark at whatever path it uses
for bin in /usr/bin/gnome-control-center /usr/libexec/gnome-control-center*; do
    [ -f "$bin" ] || continue
    for path in $(grep -a -o -E '/usr/share/[A-Za-z0-9_./+-]+\.(png|svg)' "$bin" | grep -i -E 'logo|debian' | sort -u); do
        src=logo-text-dark.png   # About is shown in dark mode
        if dpkg -S "$path" >/dev/null 2>&1 && ! dpkg-divert --list "$path" | grep -q cipher; then
            dpkg-divert --package cipher-desktop --add --rename --divert "$path.debian" "$path" || true
        fi
        mkdir -p "$(dirname "$path")"
        rm -f "$path"
        case "$path" in
            *.svg) printf '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="697" height="187"><image width="697" height="187" xlink:href="data:image/png;base64,%s"/></svg>\n' \
                       "$(base64 -w0 /usr/share/cipher/branding/$src)" > "$path" ;;
            *)     cp /usr/share/cipher/branding/$src "$path" ;;
        esac
        diag "about logo" "replaced $path"
    done
done
# and for icon-theme lookups (LOGO=cipher-logo in os-release)
for v in text text-dark; do
    cp /usr/share/cipher/branding/logo-$v.png /usr/share/icons/hicolor/256x256/apps/cipher-logo-$v.png
done
gtk-update-icon-cache -f -q /usr/share/icons/hicolor 2>/dev/null || true

# GNOME app grid: hide helper entries that aren't apps
for f in /usr/share/applications/*.desktop; do
    if grep -q -E '^Name=(Foot Client|Foot Server|KDE System Settings|Bulk Rename|Hyprland Polkit Agent|uxterm|xterm)' "$f" \
       || grep -q -E '^Exec=(footclient|foot --server|systemsettings)' "$f"; then
        grep -q '^NoDisplay=true' "$f" || sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' "$f"
    fi
done

# Compressed swap in RAM (zram): half of memory, zstd
if [ -f /etc/default/zramswap ]; then
    sed -i -E 's/^#?\s*ALGO=.*/ALGO=zstd/; s/^#?\s*PERCENT=.*/PERCENT=50/' /etc/default/zramswap
    grep -q '^PERCENT=' /etc/default/zramswap || echo PERCENT=50 >> /etc/default/zramswap
    systemctl enable zramswap.service || true
fi

# Boot splash
if command -v plymouth-set-default-theme >/dev/null; then
    plymouth-set-default-theme cipher
fi

# NVIDIA: Hyprland needs kernel modesetting
if [ -d /usr/lib/nvidia ] || dpkg -s nvidia-driver >/dev/null 2>&1; then
    mkdir -p /etc/modprobe.d
    echo "options nvidia-drm modeset=1 fbdev=1" > /etc/modprobe.d/cipher-nvidia.conf
fi

# GNOME, styled as Cipher: dark, teal accent, Cipher wallpaper and dock
mkdir -p /etc/dconf/db/local.d /etc/dconf/profile
printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user
WALL=file:///usr/share/cipher/themes/aurora/backgrounds/0-silk.png
cat > /etc/dconf/db/local.d/00-cipher <<CONF
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
accent-color='teal'
font-name='Plus Jakarta Sans 11'
document-font-name='Plus Jakarta Sans 11'
icon-theme='Papirus-Dark'
monospace-font-name='JetBrains Mono 11'
clock-show-weekday=true

[org/gnome/desktop/background]
picture-uri='$WALL'
picture-uri-dark='$WALL'
picture-options='zoom'
primary-color='#0b1518'

[org/gnome/desktop/screensaver]
picture-uri='$WALL'
primary-color='#0b1518'

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/shell]
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'foot.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Settings.desktop', 'org.gnome.Software.desktop', 'install-debian.desktop']
CONF
command -v dconf >/dev/null && dconf update || true

diag "session setup" "$(ls /usr/share/wayland-sessions /usr/share/xsessions 2>&1)
gdm: $(grep -E '^(DefaultSession|AutomaticLogin)' /etc/gdm3/daemon.conf 2>&1)
autologin unit: $(systemctl is-enabled cipher-live-autologin.service 2>&1)
display-manager: $(readlink -f /etc/systemd/system/display-manager.service)
start-hyprland: $(command -v start-hyprland Hyprland 2>&1)
qs: $(command -v qs quickshell 2>&1)"
diag "versions" "$(dpkg-query -W -f '${Package} ${Version}\n' cipher-desktop hyprland quickshell gdm3 base-files calamares 2>&1)
$(head -n 3 /etc/os-release)"

apt-get clean
