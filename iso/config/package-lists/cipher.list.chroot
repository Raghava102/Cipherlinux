# Cipher live image — packages from Debian 13 main.
# Hyprland, Quickshell and friends come from trixie-backports and are installed
# by config/hooks/live/0100-cipher.hook.chroot, together with cipher-desktop.

# Live system + installer
live-boot
live-config
live-config-systemd
calamares
calamares-settings-debian

# Boot splash
plymouth
plymouth-themes

# Login + second desktop: GDM, with the full GNOME desktop next to Cipher
task-gnome-desktop
gdm3
gnome-tweaks
firefox-esr

# Hardware & firmware
linux-image-amd64
firmware-linux
firmware-linux-nonfree
firmware-misc-nonfree
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-sof-signed
amd64-microcode
intel-microcode
mesa-vulkan-drivers
intel-media-va-driver
bluez

# Networking & audio
network-manager
pipewire
pipewire-pulse
wireplumber

# Desktop tools that Cipher's menu uses (recommended by cipher-desktop)
cliphist
udiskie
power-profiles-daemon
pavucontrol
blueman
wf-recorder
btop
thunar
chromium
gnome-themes-extra
qt6-image-formats-plugins
nano
sudo
papirus-icon-theme
ufw
curl
git

# Virtual machines: screen size follows the window, shared clipboard
open-vm-tools
open-vm-tools-desktop
spice-vdagent
# compressed RAM swap: smoother on low-memory machines and VMs
zram-tools
