#!/bin/sh
# Start every user in the Cipher session the first time they log in.
# Runs once per user (before GDM starts); after that GDM remembers whatever
# the user picks with the gear button on the login screen (Cipher or GNOME).
[ -f /usr/share/wayland-sessions/cipher.desktop ] || 
# Log straight in: the first person set up on this computer (by the installer)
# gets automatic login, once. Turn it off in Settings > Users.
first=/var/lib/cipher/autologin-configured
conf=/etc/gdm3/daemon.conf
if [ ! -e "$first" ] && [ -f "$conf" ] && ! grep -q '^AutomaticLogin=' "$conf" \
   && ! grep -qw 'boot=live' /proc/cmdline; then
    user=$(getent passwd | awk -F: '$3>=1000 && $3<60000 && $7 !~ /(nologin|false)$/ {print $1; exit}')
    if [ -n "$user" ]; then
        sed -i '/^AutomaticLoginEnable=/d' "$conf"
        sed -i "s/^\[daemon\]/[daemon]\nAutomaticLoginEnable=true\nAutomaticLogin=$user/" "$conf"
        echo "cipher: automatic login for $user"
    fi
    touch "$first"
fi
exit 0
dir=/var/lib/AccountsService/users
mark=/var/lib/cipher/default-session
mkdir -p "$dir" "$mark"

getent passwd | while IFS=: read -r name _ uid _ _ _ shell; do
    [ "$uid" -ge 1000 ] 2>/dev/null && [ "$uid" -lt 60000 ] || continue
    case "$shell" in */nologin|*/false) continue ;; esac
    [ -e "$mark/$name" ] && continue
    f="$dir/$name"
    if [ -s "$f" ]; then
        sed -i '/^XSession=/d; /^Session=/d; /^SessionType=/d' "$f"
        grep -q '^\[User\]' "$f" || sed -i '1i [User]' "$f"
        sed -i 's/^\[User\]$/[User]\nSession=cipher\nSessionType=wayland/' "$f"
    else
        printf '[User]\nSession=cipher\nSessionType=wayland\nSystemAccount=false\n' > "$f"
    fi
    chmod 600 "$f"
    touch "$mark/$name"
    echo "cipher: $name will start in the Cipher session"
done

# Log straight in: the first person set up on this computer (by the installer)
# gets automatic login, once. Turn it off in Settings > Users.
first=/var/lib/cipher/autologin-configured
conf=/etc/gdm3/daemon.conf
if [ ! -e "$first" ] && [ -f "$conf" ] && ! grep -q '^AutomaticLogin=' "$conf" \
   && ! grep -qw 'boot=live' /proc/cmdline; then
    user=$(getent passwd | awk -F: '$3>=1000 && $3<60000 && $7 !~ /(nologin|false)$/ {print $1; exit}')
    if [ -n "$user" ]; then
        sed -i '/^AutomaticLoginEnable=/d' "$conf"
        sed -i "s/^\[daemon\]/[daemon]\nAutomaticLoginEnable=true\nAutomaticLogin=$user/" "$conf"
        echo "cipher: automatic login for $user"
    fi
    touch "$first"
fi
exit 0
