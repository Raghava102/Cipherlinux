# Generated by cipher-theme for "{{name}}" — do not edit, it is overwritten.
$activeBorderColor   = rgba({{accent_hex}}ee) rgba({{secondary_hex}}ee) 45deg
$inactiveBorderColor = rgba({{border_hex}}aa)
$shadowColor         = rgba({{shadow_hex}}{{shadow_alpha}})

general {
    col.active_border = $activeBorderColor
    col.inactive_border = $inactiveBorderColor
}
decoration {
    shadow {
        color = $shadowColor
    }
}
group {
    col.border_active = rgb({{accent_hex}})
    col.border_inactive = rgb({{border_hex}})
    groupbar {
        col.active = rgb({{accent_hex}})
        col.inactive = rgb({{overlay_hex}})
        text_color = rgb({{text_hex}})
    }
}
misc {
    background_color = rgb({{bg_hex}})
}
