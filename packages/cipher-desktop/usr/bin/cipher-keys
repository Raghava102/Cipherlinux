#!/usr/bin/env python3
"""List Hyprland keybindings that have descriptions, for the Cipher menu.
Output: description<TAB><TAB>keyboard<TAB>key combo"""
import json
import subprocess
import sys

MODS = [(64, "SUPER"), (4, "CTRL"), (8, "ALT"), (1, "SHIFT")]
NAMES = {"RETURN": "Enter", "ESCAPE": "Esc", "SPACE": "Space", "PRINT": "Print",
         "mouse:272": "LMB", "mouse:273": "RMB", "mouse_down": "Scroll ↓", "mouse_up": "Scroll ↑",
         "MINUS": "-", "EQUAL": "=", "TAB": "Tab", "LEFT": "←", "RIGHT": "→", "UP": "↑", "DOWN": "↓"}

try:
    binds = json.loads(subprocess.run(["hyprctl", "-j", "binds"], capture_output=True,
                                      text=True, check=True).stdout)
except (OSError, subprocess.CalledProcessError, json.JSONDecodeError) as e:
    print(f"Could not read keybindings ({e.__class__.__name__})\t\tinfo\t")
    sys.exit(0)

seen = set()
for b in binds:
    desc = (b.get("description") or "").strip()
    if not desc or b.get("submap"):
        continue
    mods = [n for bit, n in MODS if b.get("modmask", 0) & bit]
    key = b.get("key", "")
    key = NAMES.get(key, NAMES.get(key.upper(), key.upper() if len(key) == 1 else key))
    combo = " + ".join(mods + [key])
    if (desc, combo) in seen:
        continue
    seen.add((desc, combo))
    print(f"{desc}\t\tkeyboard\t{combo}")
