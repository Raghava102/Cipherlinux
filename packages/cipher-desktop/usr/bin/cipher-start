#!/bin/bash
# Session entry point (used by the "Cipher" login session and the live ISO).
# Prepares per-user state, then hands over to Hyprland.
set -u
CUR="$HOME/.config/cipher/current"
mkdir -p "$CUR"

# First login: seed the user's Hyprland config if the skeleton wasn't copied
if [ ! -f "$HOME/.config/hypr/hyprland.conf" ]; then
  mkdir -p "$HOME/.config/hypr"
  cp /etc/skel/.config/hypr/hyprland.conf "$HOME/.config/hypr/hyprland.conf"
fi

# Theme files Hyprland sources must exist before it starts
cipher-theme init >/dev/null 2>&1 || : > "$CUR/hyprland.conf"

# Hardware-specific Hyprland settings, regenerated every login
{
  echo "# Generated by cipher-start at login — do not edit."
  if [ -d /sys/module/nvidia_drm ]; then
    echo "# NVIDIA proprietary driver detected"
    echo "env = LIBVA_DRIVER_NAME,nvidia"
    echo "env = __GLX_VENDOR_LIBRARY_NAME,nvidia"
    echo "env = NVD_BACKEND,direct"
    echo "cursor {"
    echo "    no_hardware_cursors = 1"
    echo "}"
  fi
  if grep -qs 'hypervisor' /proc/cpuinfo; then
    echo "# Virtual machine detected: software cursors avoid an invisible pointer"
    echo "cursor {"
    echo "    no_hardware_cursors = 1"
    echo "}"
    echo "# performance: no blur or shadows (no real GPU)"
    echo "decoration {"
    echo "    blur {"
    echo "        enabled = false"
    echo "    }"
    echo "    shadow {"
    echo "        enabled = false"
    echo "    }"
    echo "}"
    echo "# follow the VM window size, at scale 1 (no stretching)"
    echo "exec-once = /usr/lib/cipher/vm-display"
  fi
} > "$CUR/hardware.conf"

# Keep the compositor's output so a failed start can be diagnosed:
#   cat ~/.local/state/cipher/session.log   (from GNOME or a TTY)
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/cipher/session.log"
mkdir -p "$(dirname "$LOG")"
[ -f "$LOG" ] && mv -f "$LOG" "$LOG.old"
exec >"$LOG" 2>&1
echo "cipher-start $(date -Is) on $(cat /sys/class/dmi/id/product_name 2>/dev/null)"

# Software rendering: VMs without 3D acceleration (VMware with "Accelerate 3D
# graphics" off, VirtualBox, ...) have no usable GPU, and Hyprland crashes at
# start. If the compositor dies within a minute, start it again with Mesa's
# software renderer (llvmpipe) and remember that for the next login.
SOFT="${XDG_STATE_HOME:-$HOME/.local/state}/cipher/software-render"
hypr() {
  if command -v start-hyprland >/dev/null 2>&1; then start-hyprland; else Hyprland; fi
}
soft_env() {
  export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe WLR_RENDERER_ALLOW_SOFTWARE=1
  export AQ_NO_ATOMIC=1 QT_QUICK_BACKEND=software
}

if [ -f "$SOFT" ]; then
  echo "software rendering (remembered from an earlier login; rm $SOFT to retry the GPU)"
  soft_env
  command -v start-hyprland >/dev/null 2>&1 && exec start-hyprland
  exec Hyprland
fi

t0=$(date +%s)
hypr
rc=$?
dt=$(( $(date +%s) - t0 ))
echo "compositor exited: code $rc after ${dt}s"
if [ "$dt" -lt 60 ] && [ "$rc" -ne 0 ]; then
  echo "== quick crash: retrying with software rendering $(date -Is)"
  touch "$SOFT"
  soft_env
  t0=$(date +%s)
  hypr
  rc=$?
  dt=$(( $(date +%s) - t0 ))
  echo "compositor exited: code $rc after ${dt}s (software)"
  # it didn't help: forget it so the GPU is tried again next time
  [ "$dt" -lt 60 ] && [ "$rc" -ne 0 ] && rm -f "$SOFT"
fi
exit "$rc"
