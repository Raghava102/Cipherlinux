#!/bin/bash
# Session entry point (used by the "Cipher" login session and the live ISO).
# Prepares per-user state, then hands over to Hyprland.
set -u
CUR="$HOME/.config/cipher/current"
mkdir -p "$CUR"

# First login: seed the user's Hyprland config if the skeleton wasn't copied
if [ ! -f "$HOME/.config/hypr/hyprland.conf" ]; then
  mkdir -p "$HOME/.config/hypr"
  cp /etc/skel/.config/hypr/hyprland.conf "$HOME/.config/hypr/hyprland.conf"
fi

# Theme files Hyprland sources must exist before it starts
cipher-theme init >/dev/null 2>&1 || : > "$CUR/hyprland.conf"

# Hardware-specific Hyprland settings, regenerated every login
{
  echo "# Generated by cipher-start at login — do not edit."
  if [ -d /sys/module/nvidia_drm ]; then
    echo "# NVIDIA proprietary driver detected"
    echo "env = LIBVA_DRIVER_NAME,nvidia"
    echo "env = __GLX_VENDOR_LIBRARY_NAME,nvidia"
    echo "env = NVD_BACKEND,direct"
    echo "cursor {"
    echo "    no_hardware_cursors = 1"
    echo "}"
  fi
  if grep -qs 'hypervisor' /proc/cpuinfo; then
    echo "# Virtual machine detected: software cursors avoid an invisible pointer"
    echo "cursor {"
    echo "    no_hardware_cursors = 1"
    echo "}"
  fi
} > "$CUR/hardware.conf"

# Keep the compositor's output so a failed start can be diagnosed:
#   cat ~/.local/state/cipher/session.log   (from GNOME or a TTY)
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/cipher/session.log"
mkdir -p "$(dirname "$LOG")"
[ -f "$LOG" ] && mv -f "$LOG" "$LOG.old"
exec >"$LOG" 2>&1
echo "cipher-start $(date -Is) on $(cat /sys/class/dmi/id/product_name 2>/dev/null)"

if command -v start-hyprland >/dev/null 2>&1; then
  exec start-hyprland
fi
exec Hyprland
