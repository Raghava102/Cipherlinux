#!/bin/bash
# cipher-shell           start the Cipher shell (supervised: restarts on crash)
# cipher-shell restart   restart the running shell
# cipher-shell logs      show the shell log
# cipher-shell gpu on    (virtual machines) draw the shell with the GPU — smoother
#                        with VMware 3D acceleration; falls back automatically
# cipher-shell gpu off   back to software rendering
#
# Output goes to ~/.local/state/cipher/shell.log. If the shell keeps
# crashing with GPU rendering, it falls back to software rendering, and
# Hyprland shows a notice so a failure is never silent.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/cipher"
LOG="$LOG_DIR/shell.log"
mkdir -p "$LOG_DIR"

notify() {  # visible even when the shell (our notification daemon) is down
  command -v hyprctl >/dev/null && hyprctl notify "$1" 12000 0 "$2" >/dev/null 2>&1
}

case "${1:-run}" in
  restart)
    pkill -f 'quickshell.*cipher|qs -p .*cipher' 2>/dev/null || true
    exit 0 ;;
  logs)
    exec tail -n 200 -F "$LOG" ;;
  gpu)
    mark="$HOME/.config/cipher/gpu-shell"
    case "${2:-}" in
      on)  mkdir -p "$(dirname "$mark")"; touch "$mark"; echo "GPU rendering on — restarting the shell" ;;
      off) rm -f "$mark"; echo "GPU rendering off — restarting the shell" ;;
      *)   [ -f "$mark" ] && echo on || echo off; exit 0 ;;
    esac
    # restart the supervisor so it picks the new mode
    for p in $(pgrep -x cipher-shell); do [ "$p" != "$$" ] && kill "$p" 2>/dev/null; done
    pkill -f 'quickshell.*cipher|qs -p .*cipher' 2>/dev/null || true
    sleep 1
    setsid -f cipher-shell >/dev/null 2>&1
    exit 0 ;;
  run) ;;
  *) echo "usage: cipher-shell [run|restart|logs|gpu on|gpu off]" >&2; exit 2 ;;
esac

# Only one supervisor per session
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/cipher-shell.lock"
flock -n 9 || { echo "cipher-shell: already running" >&2; exit 0; }

cipher-theme init >/dev/null 2>&1 || true
mkdir -p "$HOME/.config/cipher/current"
[ -f "$HOME/.config/cipher/current/hardware.conf" ] || : > "$HOME/.config/cipher/current/hardware.conf"

[ -f "$LOG" ] && mv -f "$LOG" "$LOG.old"
{
  echo "=== cipher-shell $(date -Is)"
  echo "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-} XDG_CONFIG_DIRS=${XDG_CONFIG_DIRS:-} HYPRLAND_INSTANCE_SIGNATURE=${HYPRLAND_INSTANCE_SIGNATURE:+set}"
  command -v qs quickshell
} >> "$LOG" 2>&1

# The bar is the sign of life: Hyprland lists it as a "cipher-bar" layer.
bar_visible() {
  command -v hyprctl >/dev/null || return 0
  hyprctl layers 2>/dev/null | grep -q 'namespace: cipher-bar'
}

fails=0
software=${CIPHER_SOFTWARE_RENDERING:-0}
# Virtual GPUs (VMware, VirtualBox, QEMU) often can't draw Qt Quick layers:
# start straight in software rendering there. Real hardware uses the GPU.
if [ -z "${CIPHER_SOFTWARE_RENDERING:-}" ] && command -v systemd-detect-virt >/dev/null \
   && systemd-detect-virt --vm --quiet && [ ! -f "$HOME/.config/cipher/gpu-shell" ]; then
  software=1
  echo "=== virtual machine ($(systemd-detect-virt)): using software rendering" >> "$LOG"
fi
while true; do
  started=$(date +%s)
  if [ "$software" -eq 1 ]; then
    echo "=== starting (software rendering) $(date -Is)" >> "$LOG"
    QT_QUICK_BACKEND=software cipher-qs >> "$LOG" 2>&1 &
  else
    echo "=== starting $(date -Is)" >> "$LOG"
    cipher-qs >> "$LOG" 2>&1 &
  fi
  pid=$!

  # Running but not drawing (GPU driver trouble) counts as a failure too.
  if [ "$software" -eq 0 ]; then
    for _ in $(seq 1 15); do
      sleep 1
      kill -0 "$pid" 2>/dev/null || break
      bar_visible && break
    done
    if kill -0 "$pid" 2>/dev/null && ! bar_visible; then
      echo "=== shell running but nothing on screen after 15s: switching to software rendering" >> "$LOG"
      kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
      software=1
      notify 0 "Cipher shell could not draw with the GPU — using software rendering. Log: ~/.local/state/cipher/shell.log"
      continue
    fi
  fi

  wait "$pid"
  status=$?
  echo "=== exited with status $status $(date -Is)" >> "$LOG"
  [ "$status" -eq 0 ] && exit 0

  if [ $(( $(date +%s) - started )) -lt 20 ]; then
    fails=$((fails + 1))
  else
    fails=0
  fi
  if [ "$fails" -ge 2 ] && [ "$software" -eq 0 ]; then
    software=1
    fails=0
    notify 0 "Cipher shell crashed — retrying with software rendering. Log: ~/.local/state/cipher/shell.log"
  elif [ "$fails" -ge 3 ]; then
    notify 3 "Cipher shell keeps crashing. Press SUPER+RETURN for a terminal and run: cipher-shell logs"
    sleep 30
    fails=0
  fi
  sleep 2
done
