#!/usr/bin/env python3
"""cipher-shell-set KEY VALUE|toggle — change a setting in ~/.config/cipher/shell.json.
The shell watches that file and re-flows live.
Keys: barPosition (top|bottom), barTransparent, clock24h, sharpCorners, dockMagnify, greeting
      (true|false|toggle), dockPosition (bottom|left|right|hidden), dockIconSize (32-72),
      font (name), fontSize (9-20), terminal (command)."""
import json
import os
import sys
import tempfile
from pathlib import Path

path = Path.home() / ".config/cipher/shell.json"
BOOLS = {"barTransparent", "clock24h", "sharpCorners", "dockMagnify", "greeting"}
DEFAULTS = {"barTransparent": False, "clock24h": True, "sharpCorners": False, "dockMagnify": True, "greeting": True}

if len(sys.argv) != 3 or sys.argv[1] in ("-h", "--help"):
    print(__doc__.strip()); sys.exit(0 if len(sys.argv) > 1 else 2)
key, value = sys.argv[1], sys.argv[2]

try:
    data = json.loads(path.read_text())
except (OSError, json.JSONDecodeError):
    data = {}

if key in BOOLS:
    if value == "toggle":
        data[key] = not data.get(key, DEFAULTS[key])
    elif value in ("true", "false"):
        data[key] = value == "true"
    else:
        sys.exit(f"{key} takes true|false|toggle")
elif key == "barPosition":
    if value == "toggle":
        value = "bottom" if data.get(key, "top") == "top" else "top"
    if value not in ("top", "bottom"):
        sys.exit("barPosition takes top|bottom|toggle")
    data[key] = value
elif key == "dockPosition":
    if value not in ("bottom", "left", "right", "hidden"):
        sys.exit("dockPosition takes bottom|left|right|hidden")
    data[key] = value
elif key == "dockIconSize":
    if not value.isdigit() or not 32 <= int(value) <= 72:
        sys.exit("dockIconSize takes 32-72")
    data[key] = int(value)
elif key == "fontSize":
    if not value.isdigit() or not 9 <= int(value) <= 20:
        sys.exit("fontSize takes 9-20")
    data[key] = int(value)
elif key in ("font", "terminal"):
    data[key] = value
else:
    sys.exit(f"unknown setting: {key}")

path.parent.mkdir(parents=True, exist_ok=True)
fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".shell.json.")
with os.fdopen(fd, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
print(f"{key} = {data[key]}")
