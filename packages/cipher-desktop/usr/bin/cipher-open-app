#!/bin/bash
# cipher-open-app <desktop-id>  — start an app the way the dock and menu do.
# Goes through GIO (gtk-launch) so D-Bus-activated apps (GNOME Software,
# Settings, ...) start properly, gives GNOME apps that refuse to run outside
# GNOME the environment they expect, and doesn't leak the shell's own
# software-rendering setting into apps.
id="${1:?usage: cipher-open-app <desktop-id>}"; shift
id="${id%.desktop}"
log="${XDG_STATE_HOME:-$HOME/.local/state}/cipher/apps.log"
mkdir -p "$(dirname "$log")"

unset QT_QUICK_BACKEND QSG_RENDER_LOOP
case "$id" in
  # These check XDG_CURRENT_DESKTOP and exit unless it says GNOME
  org.gnome.Settings|gnome-control-center|org.gnome.Settings.*|gnome-*-panel)
    export XDG_CURRENT_DESKTOP=GNOME ;;
esac

echo "$(date -Is) open $id" >> "$log"

desktop_file() {
  for dir in "${XDG_DATA_HOME:-$HOME/.local/share}/applications" /usr/local/share/applications /usr/share/applications /var/lib/flatpak/exports/share/applications; do
    [ -f "$dir/$1.desktop" ] && { echo "$dir/$1.desktop"; return 0; }
  done
  return 1
}
f=$(desktop_file "$id")

# Terminal apps (btop, nano, ...): open in Cipher's terminal, not gnome-terminal
if [ -n "$f" ] && grep -q '^Terminal=true' "$f"; then
  exe=$(sed -n 's/^Exec=//p' "$f" | head -n1 | sed -E 's/ ?%[fFuUdDnNickvm]//g')
  setsid -f cipher-launch terminal sh -c "$exe" >> "$log" 2>&1 < /dev/null
  exit 0
fi
# gtk-launch can't D-Bus-activate ids with a '-' (not a valid object path,
# e.g. org.gnome.font-viewer): run their Exec line instead
direct=0
case "$id" in *-*) [ -n "$f" ] && grep -q '^DBusActivatable=true' "$f" && direct=1 ;; esac

if [ "$direct" = 0 ] && command -v gtk-launch >/dev/null 2>&1; then
  setsid -f gtk-launch "$id" "$@" >> "$log" 2>&1 < /dev/null && exit 0
fi
# fallback: run the Exec line ourselves
if [ -n "$f" ]; then
  exe=$(sed -n 's/^Exec=//p' "$f" | head -n1 | sed -E 's/ ?%[fFuUdDnNickvm]//g')
  [ -n "$exe" ] && { setsid -f sh -c "exec $exe" >> "$log" 2>&1 < /dev/null; exit 0; }
fi
echo "$(date -Is) cannot open $id" >> "$log"
exit 1
